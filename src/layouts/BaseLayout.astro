---
import '@/styles/global.css';
import { SITE_CONFIG } from '@/config/site';
import { getDictionary, getSeoUrls, type Locale } from '@/i18n';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  locale: Locale;
  currentRoute: string;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const {
  locale,
  currentRoute,
  title,
  description,
  jsonLd,
  ogImage,
  ogImageAlt,
  noindex = false,
} = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls(currentRoute, locale);
const isDev = import.meta.env.DEV;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as
  | string
  | undefined;

const base = SITE_CONFIG.siteUrl.replace(/\/+$/, '');
const defaultOgImage = locale === 'id' ? '/og-image-id.png' : '/og-image-en.png';
const resolvedOgImagePath = ogImage ?? defaultOgImage;
const ogImageUrl = resolvedOgImagePath.startsWith('http')
  ? resolvedOgImagePath
  : `${base}${resolvedOgImagePath.startsWith('/') ? '' : '/'}${resolvedOgImagePath}`;
const resolvedOgImageAlt = ogImageAlt ?? title;
const alternateOgLocale = locale === 'id' ? 'en_US' : 'id_ID';
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const serializedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })
    : JSON.stringify(jsonLd)
  : null;
---

<!doctype html>
<html lang={dict.langTag} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {
      googleSiteVerification && (
        <meta name="google-site-verification" content={googleSiteVerification} />
      )
    }

    <link rel="icon" type="image/svg+xml" href="/izikit-icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0B1020" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="izikit" />

    {
      !noindex && (
        <>
          <link rel="canonical" href={seo.canonical} />
          <link rel="alternate" hreflang="id" href={seo.alternates.id} />
          <link rel="alternate" hreflang="en" href={seo.alternates.en} />
          <link rel="alternate" hreflang="x-default" href={seo.alternates.xDefault} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="izikit" />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    {serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}

    <script is:inline define:vars={{ isDev }}>
      (function () {
        try {
          window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            window.__izikitDeferredPrompt = e;
            window.dispatchEvent(new Event('izikit:pwa-prompt-ready'));
          });
        } catch (e) {}

        try {
          var saved = localStorage.getItem('izikit-theme');
          if (saved === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}

        try {
          if (!('serviceWorker' in navigator)) return;
          var SW_SCHEMA = 'izikit-sw-v4';
          var storedSchema = null;
          try {
            storedSchema = localStorage.getItem('izikit-sw-schema');
          } catch (e) {}

          if (isDev || storedSchema !== SW_SCHEMA) {
            try {
              localStorage.setItem('izikit-sw-schema', SW_SCHEMA);
            } catch (e) {}

            navigator.serviceWorker
              .getRegistrations()
              .then(function (regs) {
                return Promise.all(
                  regs.map(function (reg) {
                    return reg.unregister();
                  }),
                );
              })
              .then(function () {
                if ('caches' in window) {
                  return caches.keys().then(function (keys) {
                    return Promise.all(
                      keys.map(function (key) {
                        return caches.delete(key);
                      }),
                    );
                  });
                }
              })
              .then(function () {
                if (!isDev) {
                  navigator.serviceWorker
                    .register('/sw.js', { scope: '/', updateViaCache: 'none' })
                    .catch(function () {});
                }
              })
              .catch(function () {});
            return;
          }

          if (!isDev) {
            window.addEventListener('load', function () {
              navigator.serviceWorker
                .register('/sw.js', { scope: '/', updateViaCache: 'none' })
                .then(function (reg) {
                  reg.update().catch(function () {});
                })
                .catch(function () {});
            });
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {/* Top Route Progress Loader Bar (3px) */}
    <div id="izikit-route-loader" class="izikit-route-loader" aria-hidden="true"></div>

    {/* Launch Splashscreen (shown once per session, hidden by default for SEO/no-JS) */}
    <div id="izikit-splash" class="izikit-splash" hidden aria-hidden="true">
      <div class="flex flex-col items-center gap-4">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 64 64" fill="none" class="h-11 w-11" aria-hidden="true">
            <circle cx="16.5" cy="16.5" r="12.5" fill="var(--logo-circle)"></circle>
            <rect x="35" y="4" width="25" height="25" rx="7" fill="var(--logo-tr)"></rect>
            <rect x="4" y="35" width="25" height="25" rx="7" fill="var(--logo-bl)"></rect>
            <rect x="35" y="35" width="25" height="25" rx="7" fill="var(--logo-br)"></rect>
          </svg>
          <span class="font-display text-3xl font-extrabold tracking-tight text-[var(--ink-primary)]">
            izi<span class="text-[var(--kit)]">kit</span>
          </span>
        </div>
        <div class="h-1 w-36 overflow-hidden rounded-full bg-[var(--border-subtle)]">
          <div class="izikit-splash-bar h-full rounded-full bg-[var(--accent)]"></div>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        try {
          var splash = document.getElementById('izikit-splash');
          var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var alreadyShown = false;
          try {
            alreadyShown = sessionStorage.getItem('izikit-splash-shown') === '1';
          } catch (e) {}

          if (splash && !alreadyShown && !reduced) {
            splash.hidden = false;
            try {
              sessionStorage.setItem('izikit-splash-shown', '1');
            } catch (e) {}

            var dismissed = false;
            var dismissSplash = function () {
              if (dismissed) return;
              dismissed = true;
              splash.classList.add('is-hiding');
              window.setTimeout(function () {
                splash.hidden = true;
              }, 240);
            };

            if (document.readyState === 'complete') {
              window.setTimeout(dismissSplash, 260);
            } else {
              window.addEventListener('DOMContentLoaded', function () {
                window.setTimeout(dismissSplash, 280);
              });
            }
            window.setTimeout(dismissSplash, 1100);
          }

          var loader = document.getElementById('izikit-route-loader');
          if (loader) {
            document.addEventListener('click', function (ev) {
              if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) {
                return;
              }
              var target = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
              if (!target) return;
              if (target.target && target.target !== '_self') return;
              if (target.hasAttribute('download')) return;
              var href = target.getAttribute('href') || '';
              if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0) {
                return;
              }
              try {
                var nextUrl = new URL(target.href, window.location.href);
                if (nextUrl.origin !== window.location.origin) return;
                if (nextUrl.pathname === window.location.pathname && nextUrl.search === window.location.search) {
                  return;
                }
                loader.classList.add('is-active');
              } catch (e) {}
            });

            window.addEventListener('pageshow', function () {
              loader.classList.remove('is-active');
            });
          }
        } catch (e) {}
      })();
    </script>

    <a href="#main-content" class="skip-link">{dict.site.skipToContent}</a>
    <Header locale={locale} currentRoute={currentRoute} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} currentRoute={currentRoute} />
  </body>
</html>
