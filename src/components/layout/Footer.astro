---
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';
import { getLiveTools } from '@/config/tools';
import { BrandMarkIcon, CoffeeIcon } from '@/components/shared/icons';

interface Props {
  locale: Locale;
  currentRoute: string;
}

const { locale, currentRoute } = Astro.props;
const dict = getDictionary(locale);
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const liveTools = getLiveTools();
const pdfTools = liveTools.filter((tool) => tool.category === 'pdf');
const imageTools = liveTools.filter((tool) => tool.category === 'image');
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-card)]">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-11">
    <div class="grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-3 sm:gap-8 lg:grid-cols-[1.25fr_1fr_1fr_0.85fr]">
      <div
        class="col-span-2 border-b border-[var(--border-subtle)] pb-6 sm:col-span-3 lg:col-span-1 lg:border-b-0 lg:pb-0"
      >
        <div class="space-y-2.5">
          <a
            href={getLocalizedPath('/', locale)}
            class="inline-flex items-center gap-2.5 text-lg font-extrabold text-[var(--ink-primary)] no-underline"
          >
            <BrandMarkIcon className="h-6 w-6 shrink-0" />
            <span class="font-display tracking-tight">
              izi<span class="text-[var(--kit)]">kit</span>
            </span>
          </a>
          <p class="m-0 max-w-md text-xs leading-relaxed text-[var(--ink-muted)] sm:text-sm lg:max-w-xs">
            {dict.footer.localNote}
          </p>
        </div>
      </div>

      <div class="space-y-2.5">
        <h2 class="font-data m-0 text-[11px] font-bold tracking-wider text-[var(--ink-primary)] uppercase">
          {dict.nav.pdfGroup}
        </h2>
        <ul class="m-0 list-none space-y-0.5 p-0 text-xs sm:text-sm">
          {
            pdfTools.map((tool) => {
              const meta = dict.tools[tool.id as keyof typeof dict.tools];
              return (
                <li>
                  <a
                    href={getLocalizedPath(`/${tool.slug}`, locale)}
                    class="inline-flex min-h-9 items-center py-0.5 text-[var(--ink-muted)] underline-offset-4 transition-colors hover:text-[var(--link)] hover:underline"
                  >
                    {meta.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="space-y-2.5">
        <h2 class="font-data m-0 text-[11px] font-bold tracking-wider text-[var(--ink-primary)] uppercase">
          {dict.nav.imageGroup}
        </h2>
        <ul class="m-0 list-none space-y-0.5 p-0 text-xs sm:text-sm">
          {
            imageTools.map((tool) => {
              const meta = dict.tools[tool.id as keyof typeof dict.tools];
              return (
                <li>
                  <a
                    href={getLocalizedPath(`/${tool.slug}`, locale)}
                    class="inline-flex min-h-9 items-center py-0.5 text-[var(--ink-muted)] underline-offset-4 transition-colors hover:text-[var(--link)] hover:underline"
                  >
                    {meta.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="col-span-2 space-y-2.5 border-t border-[var(--border-subtle)] pt-5 sm:col-span-1 sm:border-t-0 sm:pt-0">
        <h2 class="font-data m-0 text-[11px] font-bold tracking-wider text-[var(--ink-primary)] uppercase">
          {dict.footer.projectTitle}
        </h2>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-0.5 p-0 text-xs sm:block sm:space-y-0.5 sm:text-sm">
          <li>
            <a
              href={getLocalizedPath('/roadmap', locale)}
              class="inline-flex min-h-9 items-center py-0.5 text-[var(--ink-muted)] underline-offset-4 transition-colors hover:text-[var(--link)] hover:underline"
            >
              {dict.nav.roadmap}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/about', locale)}
              class="inline-flex min-h-9 items-center py-0.5 text-[var(--ink-muted)] underline-offset-4 transition-colors hover:text-[var(--link)] hover:underline"
            >
              {dict.nav.about}
            </a>
          </li>
          <li>
            <a
              href={SITE_CONFIG.supportUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-9 items-center py-0.5 text-[var(--ink-muted)] underline-offset-4 transition-colors hover:text-[var(--link)] hover:underline"
            >
              {dict.footer.supportLink}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath(currentRoute, otherLocale)}
              hreflang={otherLocale}
              class="inline-flex min-h-9 items-center py-0.5 text-[var(--ink-muted)] underline-offset-4 transition-colors hover:text-[var(--link)] hover:underline"
            >
              {dict.site.switchToOtherLang}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-8 flex flex-wrap items-center justify-between gap-2 border-t border-[var(--border-subtle)] pt-4 text-[11px] text-[var(--ink-muted)]"
    >
      <p class="font-data m-0">{SITE_CONFIG.brandName} v{SITE_CONFIG.version}</p>
      <a
        href={SITE_CONFIG.supportUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-recess)] px-3 text-xs font-semibold text-[var(--ink-primary)] no-underline transition-colors hover:border-[var(--hl)] hover:text-[var(--hl)]"
      >
        <CoffeeIcon className="h-4 w-4 shrink-0 text-[var(--hl)]" />
        <span>{dict.site.trakteerCta}</span>
      </a>
    </div>
  </div>
</footer>
