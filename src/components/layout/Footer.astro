---
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';
import { getLiveTools } from '@/config/tools';

interface Props {
  locale: Locale;
  currentRoute: string;
}

const { locale, currentRoute } = Astro.props;
const dict = getDictionary(locale);
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const liveTools = getLiveTools();
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-card)]">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
      <div class="space-y-2.5">
        <a
          href={getLocalizedPath('/', locale)}
          class="font-display inline-block text-lg font-bold text-[var(--ink-primary)] no-underline"
        >
          {SITE_CONFIG.brandName}
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-[var(--ink-muted)]">
          {dict.footer.localNote}
        </p>
      </div>

      <div class="space-y-2">
        <h2 class="text-sm font-semibold text-[var(--ink-primary)]">{dict.footer.activeToolsTitle}</h2>
        <ul class="m-0 list-none space-y-1 p-0 text-sm">
          {
            liveTools.map((tool) => {
              const meta = dict.tools[tool.id as keyof typeof dict.tools];
              return (
                <li>
                  <a
                    href={getLocalizedPath(`/${tool.slug}`, locale)}
                    class="inline-flex min-h-11 items-center text-[var(--ink-muted)] underline-offset-4 hover:text-[var(--ink-primary)] hover:underline"
                  >
                    {meta.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="space-y-2">
        <h2 class="text-sm font-semibold text-[var(--ink-primary)]">{dict.footer.projectTitle}</h2>
        <ul class="m-0 list-none space-y-1 p-0 text-sm">
          <li>
            <a
              href={getLocalizedPath('/about', locale)}
              class="inline-flex min-h-11 items-center text-[var(--ink-muted)] underline-offset-4 hover:text-[var(--ink-primary)] hover:underline"
            >
              {dict.nav.about}
            </a>
          </li>
          <li>
            <a
              href={`${getLocalizedPath('/about', locale)}#support`}
              class="inline-flex min-h-11 items-center text-[var(--ink-muted)] underline-offset-4 hover:text-[var(--ink-primary)] hover:underline"
            >
              {dict.footer.supportLink}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath(currentRoute, otherLocale)}
              hreflang={otherLocale}
              class="inline-flex min-h-11 items-center text-[var(--ink-muted)] underline-offset-4 hover:text-[var(--ink-primary)] hover:underline"
            >
              {dict.site.switchToOtherLang}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-[var(--border-subtle)] pt-4 text-xs text-[var(--ink-muted)]"
    >
      <p class="font-data m-0">{SITE_CONFIG.brandName} v{SITE_CONFIG.version}</p>
      <p class="m-0">100% client-side · offline PWA</p>
    </div>
  </div>
</footer>
