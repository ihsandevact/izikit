---
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { getLiveTools } from '@/config/tools';
import { BrandMarkIcon } from '@/components/shared/icons';
import ThemeToggle from './ThemeToggle';

interface Props {
  locale: Locale;
  currentRoute: string;
}

const { locale, currentRoute } = Astro.props;
const dict = getDictionary(locale);
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';

const homeHref = getLocalizedPath('/', locale);
const allToolsHref = getLocalizedPath('/tools', locale);
const aboutHref = getLocalizedPath('/about', locale);
const switchLangHref = getLocalizedPath(currentRoute, otherLocale);

const liveTools = getLiveTools();
const pdfTools = liveTools.filter((tool) => tool.category === 'pdf');
const imageTools = liveTools.filter((tool) => tool.category === 'image');

const normalizedCurrent = currentRoute === '/' ? '/' : `/${currentRoute.replace(/^\/+|\/+$/g, '')}`;
---

<header class="sticky top-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--bg-paper)]">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 sm:py-3">
    {/* Brand Mark */}
    <a
      href={homeHref}
      class="group inline-flex min-h-10 shrink-0 items-center gap-2 rounded-lg text-[var(--ink-primary)] no-underline"
    >
      <BrandMarkIcon className="h-7 w-7 shrink-0" />
      <span class="font-display text-lg font-extrabold tracking-tight">izikit</span>
    </a>

    {/* Right-aligned Minimalist Utility Bar */}
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2.5">
      <nav aria-label="Primary" class="hidden items-center gap-1 sm:flex sm:gap-2">
        <a
          href={allToolsHref}
          aria-current={normalizedCurrent === '/tools' ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-10 items-center gap-1.5 whitespace-nowrap rounded-lg px-2.5 text-xs font-medium no-underline transition-colors sm:text-[13px]',
            normalizedCurrent === '/tools'
              ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)]'
              : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
          ]}
        >
          <svg viewBox="0 0 18 18" fill="none" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
            <rect x="2.5" y="2.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="10.5" y="2.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="2.5" y="10.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="10.5" y="10.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>{dict.nav.tools}</span>
        </a>

        <a
          href={aboutHref}
          aria-current={normalizedCurrent === '/about' ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-10 items-center whitespace-nowrap rounded-lg px-2.5 text-xs font-medium no-underline transition-colors sm:text-[13px]',
            normalizedCurrent === '/about'
              ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)]'
              : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
          ]}
        >
          {dict.nav.about}
        </a>
      </nav>

      {/* Inline ID / EN Language Switcher */}
      <div class="font-data inline-flex items-center gap-1 px-1 text-xs">
        {
          locale === 'id' ? (
            <>
              <span class="font-bold text-[var(--ink-primary)]">ID</span>
              <span class="text-[var(--border-control)]" aria-hidden="true">
                /
              </span>
              <a
                href={switchLangHref}
                hreflang="en"
                aria-label={dict.site.switchToOtherLang}
                title={dict.site.switchToOtherLang}
                class="inline-flex min-h-10 items-center px-1 font-medium text-[var(--ink-muted)] no-underline hover:text-[var(--ink-primary)]"
              >
                EN
              </a>
            </>
          ) : (
            <>
              <a
                href={switchLangHref}
                hreflang="id"
                aria-label={dict.site.switchToOtherLang}
                title={dict.site.switchToOtherLang}
                class="inline-flex min-h-10 items-center px-1 font-medium text-[var(--ink-muted)] no-underline hover:text-[var(--ink-primary)]"
              >
                ID
              </a>
              <span class="text-[var(--border-control)]" aria-hidden="true">
                /
              </span>
              <span class="font-bold text-[var(--ink-primary)]">EN</span>
            </>
          )
        }
      </div>

      <ThemeToggle
        client:load
        labelToDark={dict.site.themeToDark}
        labelToLight={dict.site.themeToLight}
      />

      <button
        id="mobile-menu-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        class="inline-flex h-10 items-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-2.5 text-xs font-semibold text-[var(--ink-primary)] transition-colors hover:bg-[var(--bg-recess)] sm:hidden"
      >
        <svg viewBox="0 0 18 18" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
          <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span>{dict.site.menuLabel}</span>
      </button>
    </div>
  </div>

  {/* Compact Mobile Drawer (< 640px) */}
  <div
    id="mobile-nav-drawer"
    hidden
    class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-[var(--border-subtle)] bg-[var(--bg-card)] px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] shadow-xl sm:hidden"
  >
    <nav aria-label="Mobile" class="space-y-3">
      <div class="grid grid-cols-2 gap-1">
        <a
          href={allToolsHref}
          class="flex min-h-10 items-center rounded-lg bg-[var(--bg-recess)] px-3 text-xs font-semibold text-[var(--ink-primary)] no-underline"
        >
          {dict.nav.tools}
        </a>
        <a
          href={aboutHref}
          class="flex min-h-10 items-center rounded-lg bg-[var(--bg-recess)] px-3 text-xs font-semibold text-[var(--ink-primary)] no-underline"
        >
          {dict.nav.about}
        </a>
      </div>

      <div class="space-y-1 border-t border-[var(--border-subtle)] pt-2.5">
        <p class="m-0 px-2 text-[11px] font-bold tracking-wider text-[var(--ink-muted)] uppercase">
          {dict.nav.pdfGroup}
        </p>
        <div class="grid grid-cols-2 gap-1">
          {
            pdfTools.map((tool) => {
              const href = getLocalizedPath(`/${tool.slug}`, locale);
              const meta = dict.tools[tool.id as keyof typeof dict.tools];
              return (
                <a
                  href={href}
                  class="flex min-h-10 items-center rounded-lg px-2.5 text-xs font-medium text-[var(--ink-muted)] no-underline hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]"
                >
                  {meta.name}
                </a>
              );
            })
          }
        </div>
      </div>

      <div class="space-y-1 border-t border-[var(--border-subtle)] pt-2.5">
        <p class="m-0 px-2 text-[11px] font-bold tracking-wider text-[var(--ink-muted)] uppercase">
          {dict.nav.imageGroup}
        </p>
        <div class="grid grid-cols-2 gap-1">
          {
            imageTools.map((tool) => {
              const href = getLocalizedPath(`/${tool.slug}`, locale);
              const meta = dict.tools[tool.id as keyof typeof dict.tools];
              return (
                <a
                  href={href}
                  class="flex min-h-10 items-center rounded-lg px-2.5 text-xs font-medium text-[var(--ink-muted)] no-underline hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]"
                >
                  {meta.name}
                </a>
              );
            })
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (trigger && drawer) {
    const closeMenu = (returnFocus = false) => {
      drawer.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) {
        trigger.focus();
      }
    };

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu(false);
      } else {
        drawer.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeMenu(true);
      }
    });
  }
</script>
