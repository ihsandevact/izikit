---
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { getLiveTools } from '@/config/tools';
import { BrandMarkIcon } from '@/components/shared/icons';
import ThemeToggle from './ThemeToggle';

interface Props {
  locale: Locale;
  currentRoute: string;
}

const { locale, currentRoute } = Astro.props;
const dict = getDictionary(locale);
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';

const homeHref = getLocalizedPath('/', locale);
const aboutHref = getLocalizedPath('/about', locale);
const switchLangHref = getLocalizedPath(currentRoute, otherLocale);

const liveTools = getLiveTools();
const pdfTools = liveTools.filter((tool) => tool.category === 'pdf');
const imageTools = liveTools.filter((tool) => tool.category === 'image');

const desktopNav = [
  { href: homeHref, label: dict.nav.tools, route: '/' },
  { href: `${homeHref}#pdf-tools`, label: dict.nav.pdfGroup, route: '#pdf' },
  { href: `${homeHref}#image-tools`, label: dict.nav.imageGroup, route: '#image' },
  { href: aboutHref, label: dict.nav.about, route: '/about' },
];

const normalizedCurrent = currentRoute === '/' ? '/' : `/${currentRoute.replace(/^\/+|\/+$/g, '')}`;
const isPdfRoute = pdfTools.some((t) => `/${t.slug}` === normalizedCurrent);
const isImageRoute = imageTools.some((t) => `/${t.slug}` === normalizedCurrent);
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--bg-paper)]/95 backdrop-blur-xs"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-2 sm:px-6 sm:py-2.5">
    <a
      href={homeHref}
      class="inline-flex min-h-11 items-center gap-2 rounded-lg px-1 text-[var(--ink-primary)] no-underline"
    >
      <BrandMarkIcon className="h-7 w-7 shrink-0" />
      <span class="font-display text-xl font-bold tracking-tight">izikit</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {
        desktopNav.map((item) => {
          const isActive =
            normalizedCurrent === item.route ||
            (item.route === '#pdf' && isPdfRoute) ||
            (item.route === '#image' && isImageRoute);
          return (
            <a
              href={item.href}
              aria-current={normalizedCurrent === item.route ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium no-underline transition-colors',
                isActive
                  ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)] underline decoration-[var(--accent)] decoration-2 underline-offset-4'
                  : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchLangHref}
        hreflang={otherLocale}
        aria-label={dict.site.switchToOtherLang}
        title={dict.site.switchToOtherLang}
        class="btn-secondary font-data inline-flex h-11 min-w-11 items-center justify-center rounded-lg px-3 text-xs font-semibold tracking-wide no-underline"
      >
        {dict.site.otherLangCode}
      </a>

      <ThemeToggle
        client:load
        labelToDark={dict.site.themeToDark}
        labelToLight={dict.site.themeToLight}
      />

      <button
        id="mobile-menu-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        class="btn-secondary inline-flex h-11 items-center gap-2 rounded-lg px-3 text-sm font-medium md:hidden"
      >
        <svg viewBox="0 0 18 18" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span>{dict.site.menuLabel}</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav-drawer"
    hidden
    class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-[var(--border-subtle)] bg-[var(--bg-card)] px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] md:hidden"
  >
    <nav aria-label="Mobile" class="space-y-4">
      <div class="flex flex-col gap-1">
        <a
          href={homeHref}
          aria-current={normalizedCurrent === '/' ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium no-underline',
            normalizedCurrent === '/'
              ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)] underline decoration-[var(--accent)] decoration-2 underline-offset-4'
              : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
          ]}
        >
          {dict.nav.tools}
        </a>
        <a
          href={aboutHref}
          aria-current={normalizedCurrent === '/about' ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium no-underline',
            normalizedCurrent === '/about'
              ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)] underline decoration-[var(--accent)] decoration-2 underline-offset-4'
              : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
          ]}
        >
          {dict.nav.about}
        </a>
      </div>

      <div class="space-y-1 border-t border-[var(--border-subtle)] pt-3">
        <p class="m-0 px-3.5 pb-1 text-xs font-semibold text-[var(--ink-muted)]">
          {dict.nav.pdfGroup}
        </p>
        {
          pdfTools.map((tool) => {
            const href = getLocalizedPath(`/${tool.slug}`, locale);
            const meta = dict.tools[tool.id as keyof typeof dict.tools];
            const isActive = normalizedCurrent === `/${tool.slug}`;
            return (
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium no-underline',
                  isActive
                    ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)] underline decoration-[var(--accent)] decoration-2 underline-offset-4'
                    : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
                ]}
              >
                {meta.name}
              </a>
            );
          })
        }
      </div>

      <div class="space-y-1 border-t border-[var(--border-subtle)] pt-3">
        <p class="m-0 px-3.5 pb-1 text-xs font-semibold text-[var(--ink-muted)]">
          {dict.nav.imageGroup}
        </p>
        {
          imageTools.map((tool) => {
            const href = getLocalizedPath(`/${tool.slug}`, locale);
            const meta = dict.tools[tool.id as keyof typeof dict.tools];
            const isActive = normalizedCurrent === `/${tool.slug}`;
            return (
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium no-underline',
                  isActive
                    ? 'bg-[var(--bg-recess)] font-semibold text-[var(--ink-primary)] underline decoration-[var(--accent)] decoration-2 underline-offset-4'
                    : 'text-[var(--ink-muted)] hover:bg-[var(--bg-recess)] hover:text-[var(--ink-primary)]',
                ]}
              >
                {meta.name}
              </a>
            );
          })
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (trigger && drawer) {
    const closeMenu = (returnFocus = false) => {
      drawer.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) {
        trigger.focus();
      }
    };

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu(false);
      } else {
        drawer.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeMenu(true);
      }
    });
  }
</script>
