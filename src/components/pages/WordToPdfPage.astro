---
import ToolPageLayout from './ToolPageLayout.astro';
import WordToPdfTool from '@/tools/pdf/word-to-pdf/WordToPdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/word-to-pdf" toolKey="word-to-pdf">
  <WordToPdfTool client:load locale={locale} />
</ToolPageLayout>
