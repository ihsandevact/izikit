---
import ToolPageLayout from './ToolPageLayout.astro';
import MergePdfTool from '@/tools/pdf/merge/MergePdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/merge-pdf" toolKey="merge-pdf">
  <MergePdfTool client:load locale={locale} />
</ToolPageLayout>
