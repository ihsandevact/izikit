---
import ToolPageLayout from './ToolPageLayout.astro';
import BlurRedactImageTool from '@/tools/image/blur-redact/BlurRedactImageTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/blur-redact-image" toolKey="blur-redact-image">
  <BlurRedactImageTool client:load locale={locale} />
</ToolPageLayout>
