---
import ToolPageLayout from './ToolPageLayout.astro';
import SignatureToPngTool from '@/tools/image/signature-to-png/SignatureToPngTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/signature-to-png" toolKey="signature-to-png">
  <SignatureToPngTool client:load locale={locale} />
</ToolPageLayout>
