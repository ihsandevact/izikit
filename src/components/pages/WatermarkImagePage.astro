---
import ToolPageLayout from './ToolPageLayout.astro';
import WatermarkImageTool from '@/tools/image/watermark/WatermarkImageTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/watermark-image" toolKey="watermark-image">
  <WatermarkImageTool client:load locale={locale} />
</ToolPageLayout>
