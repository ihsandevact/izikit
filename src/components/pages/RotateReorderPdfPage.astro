---
import ToolPageLayout from './ToolPageLayout.astro';
import RotateReorderPdfTool from '@/tools/pdf/rotate-reorder/RotateReorderPdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/rotate-reorder-pdf" toolKey="rotate-reorder-pdf">
  <RotateReorderPdfTool client:load locale={locale} />
</ToolPageLayout>
