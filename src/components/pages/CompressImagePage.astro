---
import ToolPageLayout from './ToolPageLayout.astro';
import CompressImageTool from '@/tools/image/compress/CompressImageTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/compress-image" toolKey="compress-image">
  <CompressImageTool client:load locale={locale} />
</ToolPageLayout>
