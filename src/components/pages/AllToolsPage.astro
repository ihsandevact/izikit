---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolDirectory from '@/components/home/ToolDirectory';
import { getLiveTools } from '@/config/tools';
import { getDictionary, getSeoUrls, type Locale } from '@/i18n';
import { buildToolsCatalogJsonLd } from '@/lib/seo-schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls('/tools', locale);
const liveTools = getLiveTools();

const pageTitle =
  locale === 'id'
    ? 'Semua Tools PDF & Gambar Gratis Tanpa Login | izikit'
    : 'All Free PDF & Image Browser Tools No Login | izikit';

const jsonLd = buildToolsCatalogJsonLd(locale, seo, dict, pageTitle, liveTools);
---

<BaseLayout
  locale={locale}
  currentRoute="/tools"
  title={pageTitle}
  description={dict.home.catalogSubtitle}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <ToolDirectory client:load locale={locale} mode="catalog" />
  </section>
</BaseLayout>
