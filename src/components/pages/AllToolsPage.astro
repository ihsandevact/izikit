---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolDirectory from '@/components/home/ToolDirectory';
import { getDictionary, getSeoUrls, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls('/tools', locale);

const pageTitle =
  locale === 'id'
    ? 'Semua Tools Gratis Tanpa Login & Tanpa Upload | izikit'
    : 'All Free Browser Tools Without Login or Upload | izikit';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: seo.canonical,
  inLanguage: dict.langTag,
  description: dict.home.catalogSubtitle,
};
---

<BaseLayout
  locale={locale}
  currentRoute="/tools"
  title={pageTitle}
  description={dict.home.catalogSubtitle}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-10">
    <ToolDirectory client:load locale={locale} mode="catalog" />
  </section>
</BaseLayout>
