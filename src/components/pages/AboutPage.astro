---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDictionary, getLocalizedPath, getSeoUrls, type Locale } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';
import { CoffeeIcon } from '@/components/shared/icons';
import { buildAboutJsonLd } from '@/lib/seo-schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls('/about', locale);
const jsonLd = buildAboutJsonLd(locale, seo, dict);
---

<BaseLayout
  locale={locale}
  currentRoute="/about"
  title={dict.about.seoTitle}
  description={dict.about.seoDescription}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl space-y-10 px-4 py-8 sm:px-6 sm:py-12">
    <header class="space-y-3 border-b border-[var(--border-subtle)] pb-6">
      <h1 class="font-display m-0 text-[clamp(1.8rem,4vw,2.5rem)] leading-tight font-bold text-[var(--ink-primary)]">
        {dict.about.title}
      </h1>
      <p class="m-0 text-base leading-relaxed text-[var(--ink-muted)]">
        {dict.about.intro}
      </p>
    </header>

    <section aria-labelledby="privacy-heading" class="space-y-3">
      <h2 id="privacy-heading" class="font-display m-0 text-xl font-bold text-[var(--ink-primary)]">
        {dict.about.privacyTitle}
      </h2>
      {
        dict.about.privacyParagraphs.map((paragraph) => (
          <p class="m-0 text-sm leading-relaxed text-[var(--ink-muted)] sm:text-base">
            {paragraph}
          </p>
        ))
      }
    </section>

    <section aria-labelledby="roadmap-heading" class="space-y-4">
      <h2 id="roadmap-heading" class="font-display m-0 text-xl font-bold text-[var(--ink-primary)]">
        {dict.about.roadmapTitle}
      </h2>
      <ol class="m-0 list-none space-y-3 p-0">
        {
          dict.about.roadmapPhases.map((entry) => (
            <li class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-4">
              <h3 class="m-0 text-sm font-semibold text-[var(--accent)]">{entry.phase}</h3>
              <p class="m-0 mt-1 text-sm leading-relaxed text-[var(--ink-muted)]">{entry.items}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      id="support"
      aria-labelledby="support-heading"
      class="space-y-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5 sm:p-6"
    >
      <h2 id="support-heading" class="font-display m-0 text-xl font-bold text-[var(--ink-primary)]">
        {dict.about.supportTitle}
      </h2>
      <p class="m-0 text-sm leading-relaxed text-[var(--ink-muted)] sm:text-base">
        {dict.about.supportParagraph}
      </p>

      <div class="flex flex-wrap gap-2 pt-2">
        <a
          href={SITE_CONFIG.supportUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex min-h-11 items-center gap-2 rounded-lg px-4 text-sm font-semibold no-underline"
        >
          <CoffeeIcon className="h-4 w-4 shrink-0" />
          <span>{dict.site.trakteerCta}</span>
        </a>
      </div>

      <div class="pt-2">
        <a
          href={getLocalizedPath('/', locale)}
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--accent)] underline-offset-4 hover:underline"
        >
          {dict.shared.backToAllTools}
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
