---
import ToolPageLayout from './ToolPageLayout.astro';
import SplitPdfTool from '@/tools/pdf/split/SplitPdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/split-pdf" toolKey="split-pdf">
  <SplitPdfTool client:load locale={locale} />
</ToolPageLayout>
