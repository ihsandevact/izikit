---
import ToolPageLayout from './ToolPageLayout.astro';
import ImageToPdfTool from '@/tools/pdf/image-to-pdf/ImageToPdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/image-to-pdf" toolKey="image-to-pdf">
  <ImageToPdfTool client:load locale={locale} />
</ToolPageLayout>
