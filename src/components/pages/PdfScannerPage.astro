---
import ToolPageLayout from './ToolPageLayout.astro';
import PdfScannerTool from '@/tools/pdf/scanner/PdfScannerTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/pdf-scanner" toolKey="pdf-scanner">
  <PdfScannerTool client:load locale={locale} />
</ToolPageLayout>
