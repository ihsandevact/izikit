---
import ToolPageLayout from './ToolPageLayout.astro';
import FlattenCleanPdfTool from '@/tools/pdf/flatten-clean/FlattenCleanPdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/flatten-clean-pdf" toolKey="flatten-clean-pdf">
  <FlattenCleanPdfTool client:load locale={locale} />
</ToolPageLayout>
