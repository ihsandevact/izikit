---
import ToolPageLayout from './ToolPageLayout.astro';
import ComparePdfTool from '@/tools/pdf/compare/ComparePdfTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/compare-pdf" toolKey="compare-pdf">
  <ComparePdfTool client:load locale={locale} />
</ToolPageLayout>
