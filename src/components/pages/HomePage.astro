---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolDirectory from '@/components/home/ToolDirectory';
import { getDictionary, getSeoUrls, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls('/', locale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'izikit',
  url: seo.canonical,
  inLanguage: dict.langTag,
  description: dict.home.seoDescription,
};
---

<BaseLayout
  locale={locale}
  currentRoute="/"
  title={dict.home.seoTitle}
  description={dict.home.seoDescription}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-10">
    <ToolDirectory client:load locale={locale} mode="launcher" />
  </section>
</BaseLayout>
