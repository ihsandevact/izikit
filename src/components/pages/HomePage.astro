---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolDirectory from '@/components/home/ToolDirectory';
import { ShieldLocalIcon } from '@/components/shared/icons';
import { getDictionary, getLocalizedPath, getSeoUrls, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls('/', locale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'izikit',
  url: seo.canonical,
  inLanguage: dict.langTag,
  description: dict.home.seoDescription,
};
---

<BaseLayout
  locale={locale}
  currentRoute="/"
  title={dict.home.seoTitle}
  description={dict.home.seoDescription}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 pt-5 pb-4 sm:px-6 sm:pt-10 sm:pb-7">
    <div class="max-w-3xl space-y-3 sm:space-y-4">
      <h1
        class="font-display m-0 text-[clamp(1.75rem,4.4vw,3rem)] leading-[1.12] font-bold text-[var(--ink-primary)]"
      >
        {dict.home.headline}
      </h1>
      <p class="m-0 text-sm leading-relaxed text-[var(--ink-muted)] sm:text-lg">
        {dict.home.subheadline}
      </p>
      <p class="m-0 inline-flex items-center gap-2 text-xs font-medium text-[var(--success)] sm:text-sm">
        <ShieldLocalIcon className="h-4 w-4 shrink-0" />
        <span>{dict.site.privacyNote}</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-10 sm:px-6 sm:pb-12">
    <ToolDirectory client:load locale={locale} />
  </section>

  <section
    aria-labelledby="how-local-heading"
    class="border-t border-[var(--border-subtle)] bg-[var(--bg-recess)]"
  >
    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-start lg:gap-10">
        <div class="space-y-3">
          <h2
            id="how-local-heading"
            class="font-display m-0 text-xl font-bold text-[var(--ink-primary)] sm:text-2xl"
          >
            {dict.home.howItWorksTitle}
          </h2>
          <p class="m-0 text-sm leading-relaxed text-[var(--ink-muted)] sm:text-base">
            {dict.home.howItWorksLead}
          </p>
          <div class="pt-1">
            <a
              href={getLocalizedPath('/about', locale)}
              class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--accent)] underline-offset-4 hover:underline"
            >
              {dict.nav.about}
            </a>
          </div>
        </div>

        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-4 sm:p-5">
          <h3 class="m-0 text-sm font-semibold text-[var(--ink-primary)]">
            {dict.home.verifyHeading}
          </h3>
          <ol class="m-0 mt-3 space-y-2.5 pl-5 text-sm leading-relaxed text-[var(--ink-muted)]">
            {dict.home.verifySteps.map((step) => <li>{step}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
