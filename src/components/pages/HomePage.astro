---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolDirectory from '@/components/home/ToolDirectory';
import { SITE_CONFIG } from '@/config/site';
import { getLiveTools } from '@/config/tools';
import { getDictionary, getSeoUrls, type Locale } from '@/i18n';
import { buildHomeJsonLd } from '@/lib/seo-schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const seo = getSeoUrls('/', locale);
const liveTools = getLiveTools();

const jsonLd = buildHomeJsonLd(locale, seo, dict, liveTools, dict.home.faqs);
---

<BaseLayout
  locale={locale}
  currentRoute="/"
  title={dict.home.seoTitle}
  description={dict.home.seoDescription}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <ToolDirectory client:load locale={locale} mode="launcher" />

    {/* Seasonal CPNS / SSCASN Promo Strip (Indonesian homepage only) */}
    {
      locale === 'id' && SITE_CONFIG.features.showCpnsPromo && (
        <aside
          aria-labelledby="cpns-promo-heading"
          class="mt-8 rounded-2xl border border-[var(--accent-row-border)] bg-[var(--accent-row-bg)] p-4 sm:p-5"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-data rounded-md bg-[var(--accent-pill)] px-2 py-0.5 text-[10px] font-bold text-[var(--accent-pill-ink)]">
                  CPNS / PPPK
                </span>
                <h2
                  id="cpns-promo-heading"
                  class="font-display m-0 text-sm font-extrabold text-[var(--ink-primary)] sm:text-base"
                >
                  Siapkan berkas SSCASN langsung di browser, tanpa kirim KTP atau ijazah ke server
                </h2>
              </div>
              <p class="m-0 text-xs text-[var(--ink-muted)]">
                Cek kelayakan file, ganti latar pasfoto merah atau biru, kecilkan foto di bawah 200
                KB, dan kompres PDF di bawah 1 MB.
              </p>
            </div>
            <a
              href="/cpns"
              class="btn-primary inline-flex min-h-11 shrink-0 items-center justify-center rounded-xl px-4 text-xs font-bold no-underline"
            >
              Cek berkas CPNS
            </a>
          </div>
          <div class="mt-3 grid grid-cols-1 gap-2 border-t border-[var(--accent-row-border)]/70 pt-3 sm:grid-cols-2 lg:flex lg:flex-wrap">
            <a
              href="/remove-bg"
              class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3.5 text-xs font-semibold text-[var(--ink-primary)] no-underline hover:border-[var(--accent)]"
            >
              Pasfoto latar merah
            </a>
            <a
              href="/compress-image?preset=200kb"
              class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3.5 text-xs font-semibold text-[var(--ink-primary)] no-underline hover:border-[var(--accent)]"
            >
              Kompres foto &lt; 200 KB
            </a>
            <a
              href="/compress-pdf?preset=1mb"
              class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3.5 text-xs font-semibold text-[var(--ink-primary)] no-underline hover:border-[var(--accent)]"
            >
              Kompres PDF &lt; 1 MB
            </a>
            <a
              href="/pdf-scanner"
              class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3.5 text-xs font-semibold text-[var(--ink-primary)] no-underline hover:border-[var(--accent)]"
            >
              Scan dokumen ke PDF
            </a>
          </div>
        </aside>
      )
    }

    {/* Static SEO FAQ below the interactive launcher */}
    <section
      aria-labelledby="home-faq-heading"
      class="mt-12 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5 sm:p-6"
    >
      <h2
        id="home-faq-heading"
        class="font-display m-0 mb-2 text-base font-extrabold text-[var(--ink-primary)] sm:text-lg"
      >
        {dict.home.faqTitle}
      </h2>
      <div class="divide-y divide-[var(--border-subtle)]">
        {
          dict.home.faqs.map((faq) => (
            <details class="group py-3 first:pt-1 last:pb-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-[var(--ink-primary)] hover:text-[var(--link)]">
                <span>{faq.q}</span>
                <span
                  aria-hidden="true"
                  class="font-data shrink-0 text-base text-[var(--ink-muted)] transition-transform group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="m-0 mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
