---
import ToolPageLayout from './ToolPageLayout.astro';
import QrCodeTool from '@/tools/utility/qr-code/QrCodeTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/qr-code-generator" toolKey="qr-code-generator">
  <QrCodeTool client:load locale={locale} />
</ToolPageLayout>
