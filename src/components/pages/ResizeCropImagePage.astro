---
import ToolPageLayout from './ToolPageLayout.astro';
import ResizeCropImageTool from '@/tools/image/resize-crop/ResizeCropImageTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/resize-crop-image" toolKey="resize-crop-image">
  <ResizeCropImageTool client:load locale={locale} />
</ToolPageLayout>
