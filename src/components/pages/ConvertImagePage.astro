---
import ToolPageLayout from './ToolPageLayout.astro';
import ConvertImageTool from '@/tools/image/convert/ConvertImageTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/convert-image" toolKey="convert-image">
  <ConvertImageTool client:load locale={locale} />
</ToolPageLayout>
