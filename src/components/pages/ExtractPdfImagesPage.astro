---
import ToolPageLayout from './ToolPageLayout.astro';
import ExtractPdfImagesTool from '@/tools/pdf/extract-images/ExtractPdfImagesTool';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ToolPageLayout locale={locale} route="/extract-pdf-images" toolKey="extract-pdf-images">
  <ExtractPdfImagesTool client:load locale={locale} />
</ToolPageLayout>
